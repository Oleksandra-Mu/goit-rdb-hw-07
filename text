use mydb;

1
SELECT id, date, YEAR(date) as year, MONTH(date) as month, DAY(date) as day
FROM orders;

2
SELECT id, date, DATE_ADD(date, interval 1 day) as next_date
FROM orders;

3
SELECT id, date, UNIX_TIMESTAMP(date) as timestamp
FROM orders;

4
SELECT COUNT(*) as number_orders
FROM orders
WHERE date between '1996-07-10 00:00:00' and '1996-10-08 00:00:00';

5
SELECT id, date, JSON_OBJECT('id', id, 'date', date)
FROM orders;